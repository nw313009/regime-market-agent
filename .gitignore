# Streamlit local secrets — Databricks Apps supply env via app.yaml instead
.streamlit/secrets.toml

# ---------- Secrets (spec rule 5: no secrets in code) ----------
# The Massive API key comes from the Databricks secret scope "capstone", never from a file.
.env
.env.*
!.env.example
*.pem
*.key
credentials.json
secrets.yaml
secrets.yml

