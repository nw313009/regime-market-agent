# Template for local development environment variables — PLACEHOLDERS ONLY, never real values.
#
# Copy to .env and fill in the real values:   cp .env.example .env
#
# .env is git-ignored and must never be committed. This file is the only one of the pair that
# is tracked. Scope is LOCAL DEVELOPMENT ONLY: Databricks jobs read secrets from secret scopes,
# and the deployed Streamlit app gets its configuration from app resources / app.yaml.
# Neither one reads this file.

# Massive API (ingestion) — used by smoke test and MassiveClient locally
MASSIVE_API_KEY=your_key_here

# Lakebase (Checkpoint C) — dedicated project regime-market-database, values from Databricks
PGHOST=
PGPORT=5432
PGDATABASE=databricks_postgres
PGSSLMODE=require
# Shape: projects/<project>/branches/<branch>/endpoints/primary
LAKEBASE_ENDPOINT=
DATABRICKS_HOST=

# Postgres role identity — OAuth supplies the password, so never put a password here
PGUSER=

# Databricks auth for the SDK (generate_database_credential) and databricks-sql-connector
DATABRICKS_TOKEN=

# Serverless SQL warehouse HTTP path for local Delta reads, e.g. /sql/1.0/warehouses/abc123
DATABRICKS_HTTP_PATH=

# Model-call telemetry destination (C-3): delta | log | off. Overrides config.yaml's
# telemetry.mode, which is "delta" for notebooks and jobs. A local run has no SparkSession, so
# leave this at "log" unless you are deliberately testing the Delta write.
TELEMETRY_MODE=log
